{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kool-cpu",
  "version": "2.2.0",
  "identifier": "com.heshanjj.kool-cpu",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "kool-cpu",
        "width": 460,
        "height": 640,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "../../packaging/windows/kool-cpu.ico"
    ]
  }
}
